{
	// cmd-shift-b runs the default build task: the dev server for web/
	// (http.server with Cache-Control: no-store, so a rebuilt wasm is never
	// served stale). it runs until you stop it — hence isBackground
	"version": "2.0.0",
	"tasks": [
		{
			"label": "serve",
			"type": "shell",
			"command": "./serve.py",
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": [],
			"group": { "kind": "build", "isDefault": true },
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		}
	]
}
